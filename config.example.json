{
  "base_url": "https://mail.example.com",
  "domain": "example.com",
  "listen_addr": "0.0.0.0:993",
  "smtp_listen_addr": "0.0.0.0:465",
  "poll_interval": 60,
  "page_size": 100,
  "max_pages": 0,
  "insecure_auth": false,
  "tls_mode": "implicit",
